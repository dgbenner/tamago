{
  "name": "tamago",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "import": "node scripts/import.mjs",
    "check": "node scripts/check-content.mjs",
    "build:content": "node scripts/build-content.mjs",
    "content": "npm run -s import && npm run -s check && npm run -s build:content",
    "test": "node --test test/*.test.js",
    "pull": "node scripts/pull-units.mjs",
    "smoke": "node test/mobile-smoke.mjs",
    "audio-stop": "node test/audio-stop.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "bump": "node scripts/bump-version.mjs",
    "secrets": "gitleaks git . --config .gitleaks.toml --redact --no-banner",
    "test:fast": "node scripts/test-fast.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "type": "module",
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "konsta": "^5.5.0",
    "playwright": "1.64.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "6.0.0"
  }
}
